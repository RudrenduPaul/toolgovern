{
  "name": "toolgovern-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Runtime governance layer for AI agent tool calls",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "integrations/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "bench:detection-rate": "node --experimental-strip-types benchmarks/detection-rate.ts",
    "bench:latency": "node --experimental-strip-types benchmarks/latency.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18"
  }
}
